<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DayNight.Views.TimeAxisPageView">

    <UserControl.Styles>
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{DynamicResource DnAccentBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.pill.hold">
            <Setter Property="Background" Value="{DynamicResource DnSunBrush}"/>
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.next-big">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource DnAccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="14" Margin="2,0,0,0">

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <TextBlock Classes="dn-title" Text="今日时间轴"/>
                <Button Classes="page-help" Click="ShowHelp" ToolTip.Tip="本页说明">
                    <PathIcon Data="{StaticResource IconQuestion}"/>
                </Button>
            </StackPanel>

            <!-- 当前主题卡 -->
            <Border Classes="dn-card">
                <Grid ColumnDefinitions="132,*,16,240">
                    <Border Grid.Column="0" Width="132" Height="88" CornerRadius="6"
                            Background="{Binding CurrentThumbBrush}"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="6">
                        <Border Classes="pill" Classes.hold="{Binding PillIsHold}">
                            <TextBlock Text="{Binding PillText}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentThemeName}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DnTextBrush}"/>
                        <TextBlock Classes="dn-sub" Text="{Binding CurrentSpan}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="1" Background="{DynamicResource DnStrokeBrush}"
                            VerticalAlignment="Stretch" Margin="0,8"/>
                    <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding NextCaption}" FontSize="12"
                                   Foreground="{DynamicResource DnText2Brush}"/>
                        <TextBlock Classes="next-big" Text="{Binding NextTime}"/>
                        <TextBlock Text="{Binding NextDetail}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DnText2Brush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 全天时段分布 -->
            <Border Classes="dn-card">
                <StackPanel Spacing="16" Margin="0,2">
                    <TextBlock Text="全天时段分布" FontWeight="SemiBold" FontSize="14.5"
                               Foreground="{DynamicResource DnTextBrush}"/>
                    <!-- 色带 + 当前时刻指针（上行为指针时间标签预留） -->
                    <Grid x:Name="BandWrap" RowDefinitions="22,64" Opacity="{Binding TimelineOpacity}">
                        <Grid x:Name="BandHost" Grid.Row="1" MinHeight="64"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <TextBlock Grid.Column="0" Text="00:00" FontSize="10.5"
                                   Foreground="{DynamicResource DnText3Brush}"/>
                        <TextBlock Grid.Column="1" Text="06:00" FontSize="10.5"
                                   Foreground="{DynamicResource DnText3Brush}"/>
                        <TextBlock Grid.Column="2" Text="12:00" FontSize="10.5"
                                   Foreground="{DynamicResource DnText3Brush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="18:00" FontSize="10.5"
                                   Foreground="{DynamicResource DnText3Brush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="24:00" FontSize="10.5"
                                   Foreground="{DynamicResource DnText3Brush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
