<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DayNight.Views.SettingsPageView">

    <UserControl.Styles>
        <Style Selector="Button.page-help">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="Button.page-help PathIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource DnText3Brush}"/>
        </Style>
        <Style Selector="Button.page-help:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DnAccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.set-title">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DnTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.set-desc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource DnText2Brush}"/>
        </Style>
        <!-- 三段式选择按钮组（对齐原型 seg-group） -->
        <Style Selector="Border.seg-group">
            <Setter Property="BorderBrush" Value="{DynamicResource DnStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource DnCardSolidBrush}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Button.seg-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DnText2Brush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DnStrokeBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Button.seg-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource DnNavActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DnTextBrush}"/>
        </Style>
        <Style Selector="Button.seg-btn.active">
            <Setter Property="Background" Value="{DynamicResource DnAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="dn-title" Text="设置"/>
                <Button Classes="page-help" Click="ShowHelp" ToolTip.Tip="本页说明">
                    <PathIcon Data="{StaticResource IconQuestion}" Width="18" Height="18"/>
                </Button>
            </StackPanel>

            <Border Classes="dn-card">
                <StackPanel>
                    <TextBlock Text="外观" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource DnTextBrush}"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="主题"/>
                            <TextBlock Classes="set-desc" Text="晨昏线自身的界面配色"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="seg-group" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="seg-btn" Classes.active="{Binding IsSystemTheme}"
                                        Command="{Binding SelectThemeCommand}" CommandParameter="system" Content="跟随系统"/>
                                <Button Classes="seg-btn" Classes.active="{Binding IsLightTheme}"
                                        Command="{Binding SelectThemeCommand}" CommandParameter="light" Content="亮色"/>
                                <Button Classes="seg-btn" Classes.active="{Binding IsDarkTheme}"
                                        Command="{Binding SelectThemeCommand}" CommandParameter="dark" Content="暗色"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="dn-card">
                <StackPanel>
                    <TextBlock Text="启动" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource DnTextBrush}"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="开机自动启动"/>
                            <TextBlock Classes="set-desc" Text="开机后自动在后台运行"/>
                            <TextBlock Classes="set-desc" Text="{Binding AutostartNote}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Autostart}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="静默启动"/>
                            <TextBlock Classes="set-desc" Text="启动时不打开主窗口，只在托盘运行"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SilentStart}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="最小化到托盘"/>
                            <TextBlock Classes="set-desc" Text="开启后，点最小化会隐藏到托盘；点关闭可选择留在托盘或退出"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="dn-card">
                <StackPanel>
                    <TextBlock Text="调度" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource DnTextBrush}"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="全屏时延迟切换"/>
                            <TextBlock Classes="set-desc" Text="游戏或视频全屏时暂缓切换，退出后自动补上"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DeferWhenFullscreen}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="启动和唤醒时对齐主题"/>
                            <TextBlock Classes="set-desc" Text="开机或从睡眠唤醒时，立即切到当前时段的主题"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AlignOnStartAndResume}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="dn-card">
                <StackPanel>
                    <TextBlock Text="切换提示" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource DnTextBrush}"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="切换前显示提示"/>
                            <TextBlock Classes="set-desc" Text="切换前在屏幕中央短暂显示提示"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding OsdEnabled}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="提示显示时长"/>
                            <TextBlock Classes="set-desc" Text="提示停留的秒数"/>
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="3" Maximum="10" Width="180"
                                Value="{Binding OsdSeconds}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding OsdSeconds, StringFormat={}{0}s}"
                                   FontSize="12.5" Foreground="{DynamicResource DnAccentBrush}"
                                   FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="切换后通知"/>
                            <TextBlock Classes="set-desc" Text="切换完成后弹气泡提示，并记录日志"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyAfterSwitch}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="dn-card">
                <StackPanel>
                    <TextBlock Text="日志" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource DnTextBrush}"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="set-title" Text="运行日志"/>
                            <TextBlock Classes="set-desc" Text="切换记录与异常信息"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="dn-btn" Command="{Binding OpenLogsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconFolderOpen}" Width="15" Height="15"/>
                                <TextBlock Text="打开日志目录"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
