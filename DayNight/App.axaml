<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DayNight"
             x:Class="DayNight.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- 覆盖系统强调色：统一为 Logo 藏青（Fluent 运行时从顶层读取） -->
            <Color x:Key="SystemAccentColor">#31397E</Color>
            <Color x:Key="SystemAccentColorLight1">#4A55A8</Color>
            <Color x:Key="SystemAccentColorLight2">#6B76C4</Color>
            <Color x:Key="SystemAccentColorDark1">#262D68</Color>
            <Color x:Key="SystemAccentColorDark2">#1C2252</Color>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DnTextBrush" Color="#1B1B1B"/>
                    <SolidColorBrush x:Key="DnText2Brush" Color="#5D5D5D"/>
                    <SolidColorBrush x:Key="DnText3Brush" Color="#8A8A8A"/>
                    <SolidColorBrush x:Key="DnStrokeBrush" Color="#17000000"/>
                    <SolidColorBrush x:Key="DnCardBrush" Color="#B8FFFFFF"/>
                    <SolidColorBrush x:Key="DnCardSolidBrush" Color="#FDFDFE"/>
                    <SolidColorBrush x:Key="DnOsdSurfaceBrush" Color="#F2F7F8FC"/>
                    <SolidColorBrush x:Key="DnOsdOutlineBrush" Color="#8490A3"/>
                    <SolidColorBrush x:Key="DnNavActiveBrush" Color="#0E000000"/>
                    <SolidColorBrush x:Key="DnAccentBrush" Color="#31397E"/>
                    <SolidColorBrush x:Key="DnAccentHoverBrush" Color="#262D68"/>
                    <SolidColorBrush x:Key="DnSunBrush" Color="#F5A623"/>
                    <LinearGradientBrush x:Key="DnWinBgBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#F6F7FB" Offset="0"/>
                        <GradientStop Color="#E9ECF4" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DnTextBrush" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="DnText2Brush" Color="#B6B6B6"/>
                    <SolidColorBrush x:Key="DnText3Brush" Color="#8B8B8B"/>
                    <SolidColorBrush x:Key="DnStrokeBrush" Color="#17FFFFFF"/>
                    <SolidColorBrush x:Key="DnCardBrush" Color="#B82B2D34"/>
                    <SolidColorBrush x:Key="DnCardSolidBrush" Color="#2B2D34"/>
                    <SolidColorBrush x:Key="DnOsdSurfaceBrush" Color="#EF262832"/>
                    <SolidColorBrush x:Key="DnOsdOutlineBrush" Color="#626B7D"/>
                    <SolidColorBrush x:Key="DnNavActiveBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="DnAccentBrush" Color="#9AA5FF"/>
                    <SolidColorBrush x:Key="DnAccentHoverBrush" Color="#AEB6FF"/>
                    <SolidColorBrush x:Key="DnSunBrush" Color="#F5A623"/>
                    <LinearGradientBrush x:Key="DnWinBgBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1F2229" Offset="0"/>
                        <GradientStop Color="#171A20" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 导航与操作图标（Fluent UI System Icons，MIT） -->
            <StreamGeometry x:Key="IconClock">M3.5 12a8.5 8.5 0 1 1 17 0 8.5 8.5 0 0 1-17 0M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 4.65a.75.75 0 0 0-1.5.1v6.1c.06.37.37.65.75.65h4.1a.75.75 0 0 0-.1-1.5H12V6.65</StreamGeometry>
            <StreamGeometry x:Key="IconCalendar">M17.75 3C19.55 3 21 4.46 21 6.25v11.5c0 1.8-1.46 3.25-3.25 3.25H6.25A3.25 3.25 0 0 1 3 17.75V6.25C3 4.45 4.46 3 6.25 3zm1.75 5.5h-15v9.25c0 .97.78 1.75 1.75 1.75h11.5c.97 0 1.75-.78 1.75-1.75zm-11.75 6a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m4.25 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m-4.25-4a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m4.25 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m4.25 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m1.5-6H6.25c-.97 0-1.75.78-1.75 1.75V7h15v-.75c0-.97-.78-1.75-1.75-1.75</StreamGeometry>
            <StreamGeometry x:Key="IconImages">M13.75 9a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5m-7.5-6A3.25 3.25 0 0 0 3 6.25v9c0 1.8 1.46 3.25 3.25 3.25h9c1.8 0 3.25-1.46 3.25-3.25v-9c0-1.8-1.46-3.25-3.25-3.25zM4.5 6.25c0-.97.78-1.75 1.75-1.75h9c.97 0 1.75.78 1.75 1.75v9q0 .35-.13.65l-4.58-4.29c-.87-.8-2.21-.8-3.08 0l-4.58 4.3q-.13-.3-.13-.66zm6.76 6.46 4.5 4.21q-.24.08-.51.08h-9q-.27 0-.52-.08l4.5-4.21a.75.75 0 0 1 1.03 0M8.75 21c-1.15 0-2.16-.6-2.74-1.5h9.74a3.75 3.75 0 0 0 3.75-3.75V6.01c.9.58 1.5 1.59 1.5 2.74v7c0 2.9-2.35 5.25-5.25 5.25z</StreamGeometry>
