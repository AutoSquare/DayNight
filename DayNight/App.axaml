            <StreamGeometry x:Key="IconArrowClockwise">M12 4.5a7.5 7.5 0 1 0 7.42 6.4c-.07-.46.26-.9.72-.9.37 0 .7.26.76.62q.1.67.1 1.38a9 9 0 1 1-3-6.7V4.24a.75.75 0 0 1 1.5 0v3c0 .41-.34.75-.75.75h-3a.75.75 0 0 1 0-1.5h1.35a7.5 7.5 0 0 0-5.1-2</StreamGeometry>
            <StreamGeometry x:Key="IconFolderOpen">M3.5 6.25c0-.97.78-1.75 1.75-1.75h2.88q.31 0 .53.22l2.06 2.06q.22.22.53.22h5.5c.97 0 1.75.78 1.75 1.75q0 .13.04.25H8.72c-1.34 0-2.58.71-3.25 1.87L3.5 14.28zM2 17.79A3.25 3.25 0 0 0 5.25 21h11.04c1.33 0 2.57-.72 3.24-1.88l3.03-5.25A3.25 3.25 0 0 0 19.96 9a1 1 0 0 0 .04-.25c0-1.8-1.45-3.25-3.25-3.25h-5.19L9.72 3.66c-.42-.42-1-.66-1.6-.66H5.26A3.25 3.25 0 0 0 2 6.25v11.54m6.72-7.3h11.03a1.75 1.75 0 0 1 1.51 2.63l-3.03 5.25c-.4.7-1.14 1.13-1.95 1.13H5.25a1.75 1.75 0 0 1-1.51-2.63l3.03-5.25c.4-.7 1.14-1.12 1.95-1.12</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M10 5H14C14 3.9 13.1 3 12 3C10.9 3 10 3.9 10 5ZM8.5 5C8.5 3.07 10.07 1.5 12 1.5C13.93 1.5 15.5 3.07 15.5 5H21.25C21.66 5 22 5.34 22 5.75C22 6.16 21.66 6.5 21.25 6.5H19.93L18.76 18.61C18.57 20.53 16.96 22 15.03 22H8.97C7.04 22 5.43 20.53 5.24 18.61L4.07 6.5H2.75C2.34 6.5 2 6.16 2 5.75C2 5.34 2.34 5 2.75 5H8.5ZM10.5 9.75C10.5 9.34 10.16 9 9.75 9C9.34 9 9 9.34 9 9.75V17.25C9 17.66 9.34 18 9.75 18C10.16 18 10.5 17.66 10.5 17.25V9.75ZM14.25 9C14.66 9 15 9.34 15 9.75V17.25C15 17.66 14.25 18 14.25 18C13.84 18 13.5 17.66 13.5 17.25V9.75C13.5 9.34 13.84 9 14.25 9ZM6.73 18.47C6.85 19.62 7.82 20.5 8.97 20.5H15.03C16.19 20.5 17.15 19.62 17.27 18.47L18.42 6.5H5.58L6.73 18.47Z</StreamGeometry>
            <StreamGeometry x:Key="IconArrowForward">M14.72 6.28a.75.75 0 0 1 1.06-1.06l5 5c.3.3.3.77 0 1.06l-5 5a.75.75 0 1 1-1.06-1.06l3.72-3.72h-7.69a6.25 6.25 0 0 0-6.25 6.25v.5a.75.75 0 0 1-1.5 0v-.5A7.75 7.75 0 0 1 10.75 10h7.69z</StreamGeometry>
            <StreamGeometry x:Key="IconWinMin">M5 12h14</StreamGeometry>
            <StreamGeometry x:Key="IconWinMax">M5.5 5.5h13v13h-13z</StreamGeometry>
            <StreamGeometry x:Key="IconWinClose">M6 6l12 12M18 6L6 18</StreamGeometry>

            <!-- 色带渐变（壁纸预览缺失时兜底，与原型 6 色一致） -->
            <LinearGradientBrush x:Key="BandGrad0" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1A2350" Offset="0"/><GradientStop Color="#3C2F6E" Offset="0.6"/><GradientStop Color="#8A5AA8" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BandGrad1" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F0A56A" Offset="0"/><GradientStop Color="#E57B5C" Offset="0.55"/><GradientStop Color="#8F4F8F" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BandGrad2" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#57B3F0" Offset="0"/><GradientStop Color="#2F7FD4" Offset="0.55"/><GradientStop Color="#1D5AA0" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BandGrad3" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F27A4D" Offset="0"/><GradientStop Color="#C24467" Offset="0.6"/><GradientStop Color="#5E3A8C" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BandGrad4" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0E2A3A" Offset="0"/><GradientStop Color="#1C6E5E" Offset="0.55"/><GradientStop Color="#7FD8A8" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BandGrad5" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F7C6D9" Offset="0"/><GradientStop Color="#E59AB8" Offset="0.55"/><GradientStop Color="#9A6AA0" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource DnTextBrush}"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Width" Value="40"/>
        </Style>
        <Style Selector="Button.page-help">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.page-help PathIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource DnText3Brush}"/>
        </Style>
        <Style Selector="Border.dn-card">
            <Setter Property="Background" Value="{DynamicResource DnCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DnStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style Selector="TextBlock.dn-title">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DnTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.dn-sub">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource DnText2Brush}"/>
        </Style>
        <Style Selector="Button.dn-btn">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DnCardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DnTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DnStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Button.dn-btn.primary">
            <Setter Property="Background" Value="{DynamicResource DnAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Styles>
</Application>
